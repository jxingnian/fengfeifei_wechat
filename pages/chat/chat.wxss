/* pages/chat/chat.wxss */
page {
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.status-wrap {
  display: flex;
  align-items: center;
  padding-right: 16rpx;
}

.status-text {
  font-size: 24rpx;
  color: #8a90a6;
}

.chat {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.chat-list {
  flex: 1;
  overflow-y: auto;
}

.chat-inner {
  padding: 24rpx;
  padding-bottom: 40rpx;
  min-height: 100%;
  box-sizing: border-box;
}

.msg {
  display: flex;
  margin-bottom: 24rpx;
}

.msg--me {
  justify-content: flex-end;
}

.msg--ai {
  justify-content: flex-start;
}

.msg--system {
  justify-content: center;
}

.bubble {
  max-width: 72%;
  padding: 20rpx 26rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
  background: #ffffff;
}

.msg--me .bubble {
  background: #4a6cf7;
  color: #fff;
  border-top-right-radius: 8rpx;
}

.msg--ai .bubble {
  border-top-left-radius: 8rpx;
}

.msg--system .bubble {
  background: transparent;
  color: #8a90a6;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  text-align: center;
}

.chat-input {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx 0;
  box-sizing: border-box;
}

.chat-input__field {
  flex: 1;
  height: 80rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.chat-input__send {
  flex: none;
  margin-left: 16rpx;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 32rpx;
  border-radius: 40rpx;
  background: #4a6cf7;
  color: #fff;
  font-size: 28rpx;
}

.chat-talk {
  padding: 16rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  text-align: center;
}

.talk-btn {
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  background: #eef2ff;
  color: #4a6cf7;
  font-size: 30rpx;
  font-weight: 500;
}

.talk-btn--active {
  background: #4a6cf7;
  color: #fff;
}

.talk-tip {
  margin-top: 12rpx;
}

.ph {
  color: #b3b8c8;
}

.recording-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(27, 32, 51, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

.recording-box {
  width: 460rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 48rpx 32rpx;
  text-align: center;
}

.wave {
  display: flex;
  justify-content: center;
  align-items: flex-end;
  height: 80rpx;
  margin-bottom: 24rpx;
}

.wave-bar {
  width: 10rpx;
  height: 30rpx;
  margin: 0 8rpx;
  border-radius: 5rpx;
  background: #4a6cf7;
  animation: wave 0.9s ease-in-out infinite;
}

.wave-bar:nth-child(2) {
  animation-delay: 0.15s;
}

.wave-bar:nth-child(3) {
  animation-delay: 0.3s;
}

.wave-bar:nth-child(4) {
  animation-delay: 0.45s;
}

@keyframes wave {
  0%, 100% { height: 24rpx; }
  50% { height: 68rpx; }
}

.cancel-tip {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #f5544a;
}
