<navigation-bar title="添加设备" back="{{true}}" color="#1b2033" background="#f5f6fa"></navigation-bar>
<view class="ff-page"><view class="ff-body"><view class="ff-card">
  <view class="ff-card__title">绑定我的设备</view>
  <view class="ff-muted">设备联网后会在设备本地状态页面显示 6 位授权码。授权码 5 分钟有效，只能使用一次。</view>
  <view class="field"><text class="field-label">设备授权码</text>
    <input class="ff-input" type="number" value="{{code}}" bindinput="onCode" placeholder="输入设备显示的 6 位授权码" maxlength="6" />
  </view>
  <view class="ff-btn ff-btn--block {{submitting ? 'ff-btn--disabled' : ''}}" bindtap="onSubmit">{{submitting ? '绑定中…' : '添加设备'}}</view>
</view></view></view>
