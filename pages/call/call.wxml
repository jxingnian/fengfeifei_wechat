<navigation-bar title="{{title}}" back="{{true}}" color="#1b2033" background="#f5f6fa"></navigation-bar>
<view class="call">
  <view class="stage">
    <view class="stage__avatar">{{initial}}</view>
    <view class="stage__name">{{title}}</view>
    <view class="stage__status">{{statusText}}</view>
  </view>
  <view class="controls">
    <view class="control" bindtap="onToggleMute">{{muted ? '取消静音' : '静音'}}</view>
    <view class="control control--hangup" bindtap="onHangup">挂断</view>
  </view>
</view>
