<navigation-bar title="设备管理" back="{{true}}" color="#1b2033" background="#f5f6fa"></navigation-bar>
<view class="ff-page"><view class="ff-body">
  <view class="ff-card" wx:if="{{device}}">
    <view class="ff-card__title">设备信息</view>
    <view class="ff-row"><text class="ff-row__label">名称</text><input class="ff-row__value" value="{{name}}" bindinput="onName" maxlength="80" /></view>
    <view class="ff-row"><text class="ff-row__label">设备 ID</text><text class="ff-row__value" bindtap="onCopyId">{{deviceId}}</text></view>
    <view class="ff-row"><text class="ff-row__label">状态</text><text>{{statusText}}</text></view>
    <view class="ff-row"><text class="ff-row__label">最近上线</text><text>{{lastSeenText || '-'}}</text></view>
    <view class="ff-btn ff-btn--block" bindtap="onSaveName">{{busy ? '处理中…' : '保存名称'}}</view>
    <view class="ff-btn ff-btn--ghost ff-btn--block" bindtap="onOpenChat">语音对话</view>
    <view class="ff-btn ff-btn--ghost ff-btn--block" bindtap="onOpenCall">视频通话</view>
    <view class="ff-btn ff-btn--danger ff-btn--block" bindtap="onUnbind">解除绑定</view>
  </view>
  <view wx:else class="ff-empty">正在加载或设备已不属于当前账号</view>
</view></view>
