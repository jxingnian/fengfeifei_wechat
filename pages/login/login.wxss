/* pages/login/login.wxss */
page {
  height: auto;
  min-height: 100vh;
}

.tabs {
  display: flex;
  background: #fff;
  border-radius: 24rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tabs__item {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 30rpx;
  color: #8a90a6;
  border-radius: 20rpx;
}

.tabs__item--active {
  background: #4a6cf7;
  color: #fff;
  font-weight: 500;
}

.field {
  margin-bottom: 24rpx;
}

.ph {
  color: #b3b8c8;
}

.tip {
  margin-top: 16rpx;
}

.divider {
  position: relative;
  text-align: center;
  margin: 40rpx 0 32rpx;
}

.divider::before {
  content: '';
  position: absolute;
  left: 0;
  top: 20rpx;
  width: 100%;
  height: 2rpx;
  background: #eceef5;
}

.divider text {
  position: relative;
  padding: 0 24rpx;
  background: #fff;
  color: #b3b8c8;
  font-size: 24rpx;
}

.ff-btn--wechat {
  background: #07c160;
}
