<!--pages/login/login.wxml-->
<navigation-bar title="{{mode === 'register' ? '注册' : '登录'}}" back="{{true}}" color="#1b2033" background="#f5f6fa"></navigation-bar>

<view class="ff-page">
  <view class="ff-body">
    <view class="tabs">
      <view class="tabs__item {{mode === 'login' ? 'tabs__item--active' : ''}}" data-mode="login" bindtap="onSwitch">登录</view>
      <view class="tabs__item {{mode === 'register' ? 'tabs__item--active' : ''}}" data-mode="register" bindtap="onSwitch">注册</view>
    </view>

    <!-- 登录 -->
    <view class="ff-card" wx:if="{{mode === 'login'}}">
      <view class="ff-card__title">账号登录</view>
      <view class="field">
        <input class="ff-input" type="text" placeholder="账号" placeholder-class="ph" value="{{account}}" bindinput="onAccount" />
      </view>
      <view class="field">
        <input class="ff-input" password="{{!showPassword}}" placeholder="密码" placeholder-class="ph" value="{{password}}" bindinput="onPassword" />
      </view>
      <view class="ff-btn {{loading ? 'ff-btn--disabled' : ''}} ff-btn--block" bindtap="onSubmit">
        {{loading ? '登录中…' : '登录'}}
      </view>

    </view>

    <!-- 注册 -->
    <view class="ff-card" wx:else>
      <view class="ff-card__title">注册最终用户</view>
      <view class="field">
        <input class="ff-input" type="text" placeholder="账号（3-32 位）" placeholder-class="ph" value="{{account}}" bindinput="onAccount" />
      </view>
      <view class="field">
        <input class="ff-input" password="{{!showPassword}}" placeholder="密码（至少 8 位）" placeholder-class="ph" value="{{password}}" bindinput="onPassword" />
      </view>
      <view class="field">
        <input class="ff-input" type="text" placeholder="昵称（选填）" placeholder-class="ph" value="{{name}}" bindinput="onName" />
      </view>
      <view class="field">
        <input class="ff-input" password="{{!showPassword}}" placeholder="确认密码" placeholder-class="ph" value="{{confirmPassword}}" bindinput="onConfirmPassword" />
      </view>
      <view class="ff-btn {{loading ? 'ff-btn--disabled' : ''}} ff-btn--block" bindtap="onSubmit">
        {{loading ? '注册中…' : '注册并登录'}}
      </view>
      <view class="ff-muted tip">注册后可绑定当前服务商的设备</view>
    </view>

    <view class="wechat-login">
      <view class="divider"><text>或</text></view>
      <view class="ff-btn ff-btn--wechat ff-btn--block {{wxLoading ? 'ff-btn--disabled' : ''}}" bindtap="onWechatLogin">
        {{wxLoading ? '微信登录中…' : '微信一键登录'}}
      </view>
    </view>

    <view class="ff-card">
      <view class="ff-card__title">服务地址</view>
      <input class="ff-input" type="text" placeholder="http://host:port" placeholder-class="ph" value="{{baseUrl}}" bindinput="onBaseUrl" />
      <view class="ff-muted tip">调试阶段请在开发者工具中勾选「不校验合法域名」</view>
      <view class="ff-btn ff-btn--ghost ff-btn--block" bindtap="onResetBaseUrl">恢复默认地址</view>
    </view>
  </view>
</view>
